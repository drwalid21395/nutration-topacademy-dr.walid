// ============================================================
// Top Academy – Smart Swimmer Nutrition — Prisma Schema
// الإصدار: SQLite (للتجربة المحلية السريعة)
// للتبديل إلى PostgreSQL استخدم: npm run db:postgres
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------- المستخدمون والأدوار ----------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified DateTime?
  phone         String?
  passwordHash  String
  image         String?
  role          String   @default("athlete") // athlete | guardian | coach | dietitian | admin
  status        String   @default("active") // active | suspended | deleted
  isAdult       Boolean? // هل تجاوز 18 عامًا
  parentalConsent Boolean @default(false) // موافقة ولي الأمر للقاصر
  parentName    String?
  parentPhone   String?
  parentEmail   String?
  acceptTerms   Boolean  @default(false)
  acceptPrivacy Boolean  @default(false)
  lastLoginAt   DateTime?
  resetToken    String?
  resetTokenExp DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profiles       SwimmerProfile[]
  mealPlans      MealPlan[]
  foodLogs       FoodLogEntry[]
  waterLogs      WaterLogEntry[]
  trainingLogs   TrainingLogEntry[]
  recoveryLogs   RecoveryLogEntry[]
  weightLogs     WeightLogEntry[]
  mealAnalyses   MealAnalysis[]
  photos         Photo[]
  notifications  Notification[]
  notificationPrefs NotificationPref?
  competitions   Competition[]
  auditLogs      AuditLog[]
  receivedMessages Message[] @relation("ToUser")
  sentMessages   Message[]   @relation("FromUser")
  pushSubscriptions PushSubscription[]
  coachingRelations CoachRelation[] @relation("CoachUser")
  athleteRelations  CoachRelation[] @relation("AthleteUser")
  supplementsReads SupplementAck[]
  supplementProducts SupplementProduct[]
  medications     Medication[]
  labResults      LabResult[]
  supplementAssessments SupplementAssessment[]
  supplementIntakeLogs SupplementIntakeLog[]
  supplementNotifications SupplementNotification[]
  supplementApprovals SupplementApproval[] @relation("SupplementApprover")
  wearableConnections WearableConnection[]
  dailyActivities DailyActivity[]
  workoutSessions WorkoutSession[]
  dynamicTargets DynamicNutritionTarget[]
  syncLogs SyncLog[]
}

// ---------------- ملف السباح ----------------

model SwimmerProfile {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // بيانات أساسية
  fullName    String
  gender      String // male | female
  birthDate   DateTime?
  age         Int? // يُحسب تلقائيًا
  heightCm    Float?  // الطول بالسنتيمتر
  weightKg    Float?  // الوزن بالكيلوجرام
  targetWeightKg Float?
  bodyFatPercent Float?
  waistCm     Float?
  country     String?
  timezone    String?
  ageGroup    String? // child | junior | youth | adult
  swimmerLevel String? // beginner | intermediate | advanced | competitor | professional
  specialty   String? // freestyle | backstroke | breaststroke | butterfly | medley
  mainDistances String? // قيم مفصولة بفاصلة
  personalBests String? // JSON اختياري
  nextCompetitionDate DateTime?

  // بيانات التدريب
  swimSessionsPerWeek  Int? // عدد تمرينات السباحة
  swimMinutesPerSession Int? // مدة التمرين
  trainingIntensity    String? // low | moderate | high | veryHigh
  swimDistancePerSession Int? // مسافة تقريبية بالأمتار
  gymSessionsPerWeek   Int? // لياقة/جيم
  gymMinutesPerSession Int?
  gymType              String? // resistance | strength | endurance | flexibility | speed | mixed
  restDays             String? // الأيام
  trainingTime         String? // time of day
  hasDoubleTraining    Boolean @default(false)
  sleepHours           Float?
  dailyActivityLevel   String? // sedentary | light | moderate | veryActive

  // الحالة الغذائية والصحية
  goal                String? // maintenance | fatLoss | muscleGain | endurance | recovery | competition | weightGain
  allergies           String?
  dislikedFoods       String?
  dietType            String? // regular | vegetarian | semiVegetarian | glutenFree | lactoseFree
  preferredMealsPerDay Int?
  budgetLevel         String? // low | medium | high
  availableFoods      String?
  chronicConditions   String?
  medications         String?
  currentInjuries     String?
  digestiveIssues     String?
  pregnancyStatus     String? // none | pregnant | lactating
  isMinor             Boolean @default(false)
  guardianData        String? // بيانات ولي الأمر JSON
  notes               String?
  medicalAlert        Boolean @default(false) // هل يحتاج تنبيهًا طبيًا

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mealPlans   MealPlan[]
  competitions Competition[]
  nutritionTargets NutritionTargets[]
}

// ---------------- نتائج الحسابات الغذائية ----------------

model NutritionTargets {
  id             String  @id @default(cuid())
  profileId      String
  profile        SwimmerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  bmi            Float?
  bmiCategory    String?
  bmr            Float?
  tdee           Float?
  calories       Float? // السعرات المستهدفة
  calorieMin     Float? // نطاق آمن
  calorieMax     Float?
  proteinG       Float?
  carbsG         Float?
  fatG           Float?
  fiberG         Float?
  waterMl        Float? // احتياج الماء اليومي
  trainingWaterMl Float? // إضافي أثناء التمرين
  sodiumMg       Float?
  proteinPct     Float?
  carbsPct       Float?
  fatPct         Float?
  mealCalories   String? // توزيع السعرات على الوجبات (JSON)
  trainingCalories String? // السعرات المستهلكة في التمرين (JSON)
  formula        String? // المعادلة المستخدمة
  recommendations String? // توصيات أيام التدريب/الراحة/البطولة (JSON)
  createdAt      DateTime @default(now())

  mealPlans MealPlan[]
}

// ---------------- قاعدة بيانات الطعام ----------------

model FoodCategory {
  id        String  @id @default(cuid())
  nameAr    String
  nameEn    String?
  sortOrder Int     @default(0)
  foods     FoodItem[]
}

model FoodItem {
  id           String  @id @default(cuid())
  nameAr       String
  nameEn       String?
  categoryId   String?
  category     FoodCategory? @relation(fields: [categoryId], references: [id])
  portionLabel String? // حجم الحصة (مثال: "قطعة متوسطة")
  gramsPerPortion Float? // الوزن بالجرام
  calories     Float?
  proteinG     Float?
  carbsG       Float?
  fatG         Float?
  fiberG       Float?
  sugarsG      Float?
  sodiumMg     Float?
  ingredients  String?
  allergens    String?
  cookingMethod String?
  imageUrl     String?
  similarTo    String?
  region       String?
  isPreWorkout  Boolean @default(false)
  isPostWorkout Boolean @default(false)
  isCompetition Boolean @default(false)
  isKidFriendly Boolean @default(true)
  isVegetarian  Boolean @default(false)
  hasLactose    Boolean @default(false)
  hasGluten     Boolean @default(false)
  isCommon      Boolean @default(false)
  isActive      Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  planItems MealItem[]
}

// ---------------- الخطط الغذائية ----------------

model MealPlan {
  id            String  @id @default(cuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId     String?
  profile       SwimmerProfile? @relation(fields: [profileId], references: [id])
  competitionId String? @unique
  competition   Competition? @relation(fields: [competitionId], references: [id])
  targetsId     String?
  targets       NutritionTargets? @relation(fields: [targetsId], references: [id])
  title         String
  durationDays  Int     @default(7)
  planType      String? // daily | threeDays | week | twoWeeks | thirtyDays | competitionPrep | competitionDay | postCompetition
  goal          String?
  totalCalories Float?
  proteinG      Float?
  carbsG        Float?
  fatG          Float?
  waterMl       Float?
  mealsPerDay   Int     @default(5)
  isCompetitionMode Boolean @default(false)
  isActive      Boolean @default(false)
  version       Int     @default(1)
  generatedWith String? // formula version
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  meals     Meal[]
  reports   Report[]
}

model Meal {
  id        String   @id @default(cuid())
  planId    String
  plan      MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayNumber Int      @default(1)
  mealType  String // breakfast | snack1 | preWorkout | lunch | duringWorkout | postWorkout | dinner | snack2 | supper
  title     String
  timing    String? // مثال: "8:00 صباحًا"
  calories  Float?
  proteinG  Float?
  carbsG    Float?
  fatG      Float?
  note      String? // نصائح / توقيت
  items     MealItem[]

  @@index([planId, dayNumber])
}

model MealItem {
  id        String @id @default(cuid())
  mealId    String
  meal      Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodId    String?
  food      FoodItem? @relation(fields: [foodId], references: [id])
  foodNameAr String
  quantity  String? // كمية بجرام أو وحدة منزلية
  grams     Float?
  calories  Float?
  proteinG  Float?
  carbsG    Float?
  fatG      Float?
  isAlternative Boolean @default(false) // بديل
  alternativeType String? // economical | vegetarian | lactoseFree | glutenFree | swap
}

// ---------------- السجل اليومي ----------------

model FoodLogEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  mealType  String?
  foodName  String
  grams     Float?
  calories  Float?
  proteinG  Float?
  carbsG    Float?
  fatG      Float?
  fiberG    Float?
  sodiumMg  Float?
  waterMl   Float? // ماء مصاحب
  source    String @default("manual") // manual | analysis | photo
  analysisId String? @unique
  analysis   MealAnalysis? @relation(fields: [analysisId], references: [id])
  note      String?
  createdAt DateTime @default(now())
}

model WaterLogEntry {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @default(now())
  amountMl Float
  note   String?
  createdAt DateTime @default(now())
}

model TrainingLogEntry {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  sessionType String // swim | gym
  durationMin Int?
  distanceM   Int?
  intensity   String?
  caloriesBurned Float?
  note        String?
  createdAt   DateTime @default(now())
}

model RecoveryLogEntry {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  sleepHours  Float?
  energyLevel Int? // 1-10
  hungerLevel Int? // 1-10
  stressLevel Int? // 1-10
  recoveryLevel Int? // 1-10
  weightKg    Float?
  notes       String?
  createdAt   DateTime @default(now())
}

model WeightLogEntry {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date    DateTime @default(now())
  weightKg Float
  note    String?
  createdAt DateTime @default(now())
}

// ---------------- تحليل الوجبات بالكاميرا ----------------

model Photo {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  storageKey String?
  analysisConsent Boolean @default(true)
  autoDeleteAt DateTime? // مدة الاحتفاظ
  analysis  MealAnalysis?
  createdAt DateTime @default(now())
}

model MealAnalysis {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoId     String? @unique
  photo       Photo?  @relation(fields: [photoId], references: [id])
  provider    String @default("mock") // mock | openai | gemini
  rawResponse String? // استجابة المزود (JSON)
  foods      String? // قائمة الأطعمة المكتشفة (JSON)
  totalCalories Float?
  totalProteinG Float?
  totalCarbsG   Float?
  totalFatG     Float?
  totalFiberG   Float?
  totalSodiumMg Float?
  confidence Float?
  isEstimate Boolean @default(true)
  needsReview Boolean @default(false)
  notes     String?
  loggedAs  FoodLogEntry?
  createdAt DateTime @default(now())
}

// ---------------- البطولات ----------------

model Competition {
  id            String  @id @default(cuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId     String?
  profile       SwimmerProfile? @relation(fields: [profileId], references: [id])
  name          String
  startDate     DateTime
  endDate       DateTime?
  location      String?
  expectedTemp  String?
  foodAvailableAtVenue Boolean @default(true)
  races         String? // تفاصيل السباقات والمواعيد (JSON)
  weighInTime   DateTime?
  warmUpTime    DateTime?
  plan          MealPlan?
  checklist     String? // JSON
  bagList       String? // JSON
  isActive      Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------- الإشعارات والتنبيهات ----------------

model NotificationPref {
  id           String  @id @default(cuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  breakfastTime String?
  lunchTime     String?
  dinnerTime    String?
  snackTimes    String? // JSON
  preWorkoutTime String?
  postWorkoutTime String?
  waterInterval Int? // بالدقائق
  trainingTime  String?
  sleepTime     String?
  weighInTime   String?
  competitionReminderDays Int? 
  planReviewReminderDays Int?
  soundEnabled  Boolean @default(false)
  quietHoursStart String?
  quietHoursEnd String?
  pushEnabled   Boolean @default(false)
  inAppEnabled  Boolean @default(true)
  smartAlerts   Boolean @default(true)
  waterLowAlertThreshold Int? // نسبة
  days          String? // JSON أيام الأسبوع
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // meal | water | training | sleep | weight | competition | review | smart | system
  title     String
  body      String?
  channel   String @default("inapp") // inapp | push
  isRead    Boolean @default(false)
  isDismissed Boolean @default(false)
  scheduledFor DateTime?
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())
}

// ---------------- المكملات (محتوى تثقيفي) ----------------

model Supplement {
  id             String  @id @default(cuid())
  nameAr         String
  nameEn         String?
  category       String?
  descriptionAr  String?
  functionAr     String? // وظيفته المحتملة
  consideredCasesAr String? // متى يُنظر فيه
  avoidGroupsAr  String? // الفئات التي تتجنبه
  sideEffectsAr  String?
  interactionsAr String?
  needsLabTest   Boolean @default(false)
  needsMedicalSupervision Boolean @default(false)
  naturalAlternativesAr String?
  isProhibitedRisk Boolean @default(false)
  sortOrder      Int @default(0)
  isActive       Boolean @default(true)

  // ملف علمي للحاسبة الذكية
  key               String? // معرف برمجي ثابت (protein, creatine, caffeine, …)
  scientificName    String?
  evidenceStrength  String? // A | B | C | D
  minAge            Int?
  suitableForMinors Boolean @default(false)
  needsRx           Boolean @default(false) // وصفة/إشراف طبي إلزامي
  linkedToWeight    Boolean @default(false)
  linkedToTraining  Boolean @default(false)
  linkedToCompetition Boolean @default(false)
  doseUnit          String? // g | mg | scoop | cup
  minDose           Float?
  maxDose           Float?
  safeUpperLimit    Float? // حد أعلى آمن يوقظ تحذيرًا قبله
  timingAr          String?
  relationToMealsAr String?
  durationDays      Int?
  stopPeriodAr      String?
  medicationInteractionsAr String?
  supplementInteractionsAr String?
  contraindicationsAr String?
  stopSymptomsAr    String?
  dopingRisk        String? // none | low | medium | high | prohibited | unknown
  thirdPartyTestedRecommended Boolean @default(false)
  referencesAr      String?
  lastInfoUpdate    DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  acknowledgements SupplementAck[]
}

model SupplementAck {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplementId String
  supplement   Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)
  acknowledgeConsulting Boolean @default(false)
  createdAt    DateTime @default(now())
}

// ---------------- حاسبة المكملات الذكية ----------------

model SupplementIngredient {
  id          String  @id @default(cuid())
  nameAr      String
  nameEn      String
  unit        String // g | mg
  upperLimit  Float? // حد أعلى آمن يومي
  severeLimit Float?
  sourceAr    String?
  createdAt   DateTime @default(now())
}

model SupplementProduct {
  id            String  @id @default(cuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  brand         String?
  ingredientsJson String? // [{name, amount, unit}] — لكشف التكرار والحدود
  batchNumber   String?
  batchVerified Boolean @default(false)
  thirdPartyTested Boolean @default(false)
  dopingRisk    String  @default("unknown") // none | low | medium | high | prohibited | unknown
  expiryDate    DateTime?
  dailyDose     String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Medication {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  purpose   String?
  dosage    String?
  frequency String?
  createdAt DateTime @default(now())
}

model LabResult {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marker         String // hemoglobin | ferritin | iron | transferrin | vitaminD | b12 | folate | calcium | magnesium | kidney | liver | thyroid | glucose
  markerAr       String?
  value          Float
  unit           String
  referenceRange String?
  testDate       DateTime
  notes          String?
  uploadedUrl    String?
  createdAt      DateTime @default(now())
}

model SupplementAssessment {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId            String?
  version              String   @default("1.0")
  status               String   @default("calculated") // calculated | needs-review | approved | rejected | adjusted
  overallLevel         String   @default("none") // none | low | medium | specialist
  needsMedicalApproval Boolean  @default(false)
  needsGuardianConsent Boolean  @default(false)
  needsLabTest         Boolean  @default(false)
  coverage             String? // JSON
  eligibility          String? // JSON
  proteinGap           String? // JSON
  hydration            String? // JSON
  recommendations      String? // JSON
  schedule             String? // JSON
  foodAlternatives     String? // JSON
  reassessAt           DateTime?
  createdAt            DateTime @default(now())
  recommendationItems  SupplementRecommendation[]
  approvals            SupplementApproval[]
}

model SupplementRecommendation {
  id               String @id @default(cuid())
  assessmentId     String
  assessment       SupplementAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  supplementKey    String
  nameAr           String
  status           String @default("needs-review") // food-first | needs-review | approved | rejected | blocked
  eligibilityVerdict String
  evidenceStrength String?
  coverageFromFood Float?
  deficit          Float?
  doseEstimate     Float?
  doseUnit         String?
  timingAr         String?
  durationDays     Int?
  upperLimitWarning String?
  medicalNote      String?
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime @default(now())
}

model SupplementApproval {
  id           String   @id @default(cuid())
  assessmentId String
  assessment   SupplementAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  approverId   String
  approver     User     @relation("SupplementApprover", fields: [approverId], references: [id], onDelete: Cascade)
  action       String // approved | rejected | adjusted
  notes        String?
  signature    String?
  createdAt    DateTime @default(now())
}

model SupplementIntakeLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String?
  supplementName  String
  doseAmount      Float
  doseUnit        String
  timeTaken       DateTime?
  withFood        Boolean  @default(true)
  compliant       Boolean  @default(true)
  sideEffects     String?
  energyLevel     Int?
  sleepQuality    Int?
  recoveryLevel   Int?
  performanceLevel Int?
  stomachIssues   String?
  weightChangeKg  Float?
  athleteNotes    String?
  coachNotes      String?
  specialistNotes String?
  logDate         DateTime @default(now())
}

model SupplementNotification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // reminder | interaction | reanalysis | expiry | competition
  title       String
  body        String?
  isRead      Boolean  @default(false)
  scheduledFor DateTime?
  createdAt   DateTime @default(now())
}

model SupplementReference {
  id             String   @id @default(cuid())
  supplementKey  String
  organization   String
  year           Int?
  title          String
  url            String?
  noteAr         String?
  createdAt      DateTime @default(now())
}

// ---------------- التواصل والتدريب ----------------

model CoachRelation {
  id        String  @id @default(cuid())
  coachId   String
  coach     User    @relation("CoachUser", fields: [coachId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   User    @relation("AthleteUser", fields: [athleteId], references: [id], onDelete: Cascade)
  status    String @default("pending") // pending | active | rejected
  canEditPlan Boolean @default(false)
  canViewHealth Boolean @default(false)
  nextReviewAt DateTime?
  createdAt DateTime @default(now())

  @@unique([coachId, athleteId])
}

// ---------------- إشعارات الدفع (PWA) ----------------

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("FromUser", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("ToUser", fields: [toId], references: [id], onDelete: Cascade)
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------------- التقارير ----------------

model Report {
  id        String   @id @default(cuid())
  userId    String
  planId    String?
  plan      MealPlan? @relation(fields: [planId], references: [id])
  type      String @default("weekly") // weekly | plan | progress | competition
  title     String
  summary   String? // JSON
  pdfUrl    String?
  version   String?
  createdAt DateTime @default(now())
}

// ---------------- المحتوى والإدارة ----------------

model ContentPage {
  id      String @id @default(cuid())
  slug    String @unique
  titleAr String
  bodyAr  String
  published Boolean @default(true)
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id      String @id @default(cuid())
  key     String @unique
  value   String?
  json    String? // JSON
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  ip        String?
  metadata  String? // JSON
  createdAt DateTime @default(now())
}

// ---------------- الساعات الذكية والبيانات الصحية ----------------

model WearableConnection {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String   // appleHealth | healthConnect | samsungHealth | fitbit | garmin | huawei | xiaomi | amazfit | polar | whoop | oura | strava | manual
  providerName  String
  status        String   @default("connected") // connected | disconnected | error
  deviceName    String?
  accessToken   String? // مشفّر
  refreshToken  String? // مشفّر
  tokenExpiresAt DateTime?
  scopes        String? // JSON — الصلاحيات الممنوحة
  consentAt     DateTime?
  lastSyncAt    DateTime?
  lastSyncError String?
  source        String   @default("device") // device | manual
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model DailyActivity {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                DateTime
  steps               Int      @default(0)
  distanceM           Float?
  activeCalories      Float? // سعرات النشاط فقط (بدون BMR)
  restingCalories     Float? // BMR/راحة
  workoutCalories     Float? // سعرات التدريبات المسجلة
  totalCaloriesBurned Float? // إجمالي المحروق كما يعرضه الجهاز
  workoutMinutes      Int      @default(0)
  sleepMinutes        Int?
  avgHeartRate        Int?
  restingHeartRate    Int?
  trainingLoad        String? // rest | light | moderate | hard | veryHigh
  loadScore           Float?
  sources             String? // JSON — المزودون المساهمون
  confidence          String? // high | medium | estimated
  updatedAt           DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model WorkoutSession {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sportType      String   // swim | gym | run | cycle | walk | other
  startTime      DateTime
  durationMin    Int?
  caloriesBurned Float?
  distanceM      Float?
  intensity      String? // low | moderate | high | veryHigh
  source         String   @default("manual") // device | manual
  provider       String?
  externalId     String? // معرف المصدر — لتفادي التكرار من أكثر من مزود
  laps           Int?
  poolLengthM    Float?
  strokeType     String?
  avgPacePer100m Float?
  swolf          Float?
  avgHeartRate   Int?
  note           String?
  confidence     String? // high | medium | estimated
  createdAt      DateTime @default(now())

  @@index([userId, startTime])
}

model DynamicNutritionTarget {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime
  baseCalories      Float // الهدف الأساسي قبل النشاط
  activityCalories  Float  @default(0) // السعرات المؤهلة فقط (بعد المعاوضة)
  compensationFactor Float @default(0.5)
  adjustedCalories  Float
  proteinG          Float?
  carbsG            Float?
  fatG              Float?
  waterMl           Float?
  consumedCalories  Float? // لقطة لحظة الحساب
  adjustments       String? // JSON — تفاصيل التعديل
  reason            String? // شرح سبب التعديل
  isAdjusted        Boolean @default(false)
  createdAt         DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model SyncLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  status     String   // success | error | skipped
  items      Int      @default(0)
  message    String?
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}
