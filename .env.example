# ============================================================
# Top Academy – Smart Swimmer Nutrition
# ملف إعدادات البيئة (انسخ إلى .env وعدّل القيم)
# ============================================================

# ---------- قاعدة البيانات ----------
# PostgreSQL (الإنتاج / الأفضل):
# DATABASE_URL="postgresql://user:password@localhost:5432/top_academy?schema=public"
# SQLite (للتجربة السريعة محليًا بدون خادم):
DATABASE_URL="file:./dev.db"

# ---------- Next.js ----------
NEXTAUTH_URL="http://localhost:3000"
# سِرّ تشفير الجلسات — ولّده بأمر: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-long-random-secret-at-least-32-chars"

# ---------- تحليل الطعام بالذكاء الاصطناعي ----------
# اترك القيم فارغة ليعمل النظام بوضع المحاكاة التجريبي (Mock)
# ثم ضع مفتاحك الحقيقي عند التفعيل — لا تكتبه في كود الواجهة أبدًا
AI_PROVIDER="mock"   # قيم مقبولة: mock | openai | gemini | groq
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_VISION_MODEL="gemini-2.5-flash"
GROQ_API_KEY=""
GROQ_VISION_MODEL="qwen/qwen3.6-27b"

# ---------- الربط مع Google Drive / Sheets (Apps Script Web App) ----------
# بعد نشر السكربت: App Script -> Deploy -> Web app -> انسخ الرابط هنا
GOOGLE_APPSCRIPT_URL=""

# ---------- حفظ الصور (قاعدة محلية أو S3/Cloudinary) ----------
# يدعم النظام التخزين المحلي افتراضيًا، مع إمكانية الربط لاحقًا
STORAGE_BASE_URL="http://localhost:3000"

# ---------- بريد الإشعارات (اختياري لاحقًا) ----------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ---------- ربط الساعات الذكية (Wearables) ----------
# المنصات التي تعمل من المتصفح مباشرة (OAuth ذاتي التسجيل):
# POLAR_CLIENT_ID / POLAR_CLIENT_SECRET   ← https://admin.polaraccesslink.com
# STRAVA_CLIENT_ID / STRAVA_CLIENT_SECRET ← https://www.strava.com/settings/api
# FITBIT_CLIENT_ID / FITBIT_CLIENT_SECRET ← https://dev.fitbit.com
# OURA_CLIENT_ID / OURA_CLIENT_SECRET     ← https://cloud.ouraring.com/oauth
# المنصات الأخرى (Apple Health / Health Connect / Garmin / Huawei / WHOOP / Zepp)
# تتطلب تطبيق موبايل أو شراكة رسمية وتُفعَّل عند توفرها.
POLAR_CLIENT_ID=""
POLAR_CLIENT_SECRET=""
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""
OURA_CLIENT_ID=""
OURA_CLIENT_SECRET=""
